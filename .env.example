# ===================================================
# VitalSync HMS - Cloud Database & Backend Environment
# ===================================================

# 1. Free Cloud Database (Supabase PostgreSQL):
# Go to https://supabase.com -> Create Free Project
# Settings -> API -> Project URL & Project API Key (anon/public)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-api-key"

# 2. Prisma Database Connection String:
# Settings -> Database -> Connection string (URI)
DATABASE_URL="postgresql://postgres:[YOUR-DATABASE-PASSWORD]@db.your-project-id.supabase.co:5432/postgres"

# 3. Application Security Secret:
NEXTAUTH_SECRET="vitalsync-hospital-saas-security-salt-2026"

# 4. Optional WhatsApp & SMS Gateway:
# WHATSAPP_API_KEY=""
# SMS_GATEWAY_AUTH=""
